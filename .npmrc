# fixtures/10-react-quill intentionally installs a real, unmaintained npm
# package (react-quill@2.0.0) whose declared peerDependencies cap
# react/react-dom at ^18 — exactly the "legacy package that hasn't caught
# up to React 19" scenario this project targets. Without this, `npm
# install` would ERESOLVE-fail before the fixture could even demonstrate
# the React 19 failure it exists to show.
legacy-peer-deps=true
