{
  "name": "react-legacy-compat",
  "version": "0.1.0",
  "description": "Vite plugin restoring findDOMNode for legacy React dependencies (react-transition-group, react-quill, ...) under React 19+, without modifying their source.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "src"
  ],
  "scripts": {
    "build": "node -e \"console.log('no build step: shipped as plain ESM source')\"",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "react",
    "react19",
    "vite",
    "vite-plugin",
    "finddomnode",
    "find-dom-node",
    "compatibility",
    "migration",
    "react-transition-group",
    "react-quill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitybuddha29/react-legacy-compat.git",
    "directory": "packages/react-legacy-compat"
  },
  "homepage": "https://github.com/infinitybuddha29/react-legacy-compat#readme",
  "bugs": {
    "url": "https://github.com/infinitybuddha29/react-legacy-compat/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "jsdom": "27.1.0"
  },
  "license": "MIT"
}
