{
  "name": "react-legacy-compat",
  "version": "0.3.0",
  "description": "Restore ReactDOM.findDOMNode under React 19 for legacy dependencies (react-transition-group, react-quill, react-draggable, ...) without patching node_modules. Works with Next.js (Turbopack + webpack), Vite and webpack 5.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./next": "./src/next.js"
  },
  "files": [
    "index.js",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"console.log('no build step: shipped as plain ESM source')\"",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "react",
    "react19",
    "react-19",
    "findDOMNode",
    "finddomnode",
    "find-dom-node",
    "nextjs",
    "next",
    "turbopack",
    "vite",
    "vite-plugin",
    "webpack",
    "webpack-plugin",
    "compatibility",
    "migration",
    "react-transition-group",
    "react-quill",
    "react-draggable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitybuddha29/react-legacy-compat.git",
    "directory": "packages/react-legacy-compat"
  },
  "homepage": "https://github.com/infinitybuddha29/react-legacy-compat#readme",
  "bugs": {
    "url": "https://github.com/infinitybuddha29/react-legacy-compat/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=5.0.0",
    "webpack": ">=5.0.0",
    "next": ">=15.3.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true },
    "webpack": { "optional": true },
    "next": { "optional": true }
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "jsdom": "27.1.0"
  },
  "license": "MIT"
}
